generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPERADMIN
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
}

model Branch {
  id           String        @id @default(cuid())
  name         String
  address      String?
  createdAt    DateTime      @default(now())
  appointments Appointment[]
}

model Service {
  id           String        @id @default(cuid())
  name         String
  price        Int           @default(0)
  createdAt    DateTime      @default(now())
  appointments Appointment[]
}

model Appointment {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String
  date          DateTime
  time          String
  message       String?
  status        String   @default("pending")
  paymentStatus String   @default("unpaid")
  transactionId String?
  totalAmount   Int      @default(0)
  depositAmount Int      @default(0)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  ownerId String?

  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  createdAt DateTime @default(now())
}
